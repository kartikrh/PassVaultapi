# PostgreSQL database connection settings
# Sequelize connection details for the PostgreSQL database
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=example_db_password
POSTGRES_DATABASE=score_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DIALECT=postgres

# Security settings
# SECRET_KEY_TOKEN is used to sign JWT tokens
SECRET_KEY_TOKEN=your_jwt_secret_token_here
# SECRET_HASH_KEY_TABID is used for hashing tab IDs and other data
SECRET_HASH_KEY_TABID=your_hash_secret_here
# TOKEN_EXPIRY_TIME is the JWT expiration duration (e.g. 4h, 30m, 1d)
TOKEN_EXPIRY_TIME=4h
# ENCRYPTION_KEY must be a 32-character key for AES-256 encryption
ENCRYPTION_KEY=32_character_encryption_key_here

# Error monitoring
# SENTRY_DSN is required only when ENABLE_SENTRY=TRUE
SENTRY_DSN=
# ENABLE_SENTRY is checked in app.js and should be set to TRUE to enable Sentry
ENABLE_SENTRY=FALSE

# Socket admin credentials
# Used by Socket.IO admin UI basic authentication
SOCKET_ADMIN_USERNAME=admin_user
SOCKET_ADMIN_PASSWORD=admin_password

# Background job scheduler flag
# Set to true to register cron jobs at startup
IS_CRON_ENABLE=true

# Vault feature settings
# Drive OAuth (utilities/googleDrive.js) reuses each White Label's own Google
# OAuth client -- same one Sign-In uses (see tblWhitelabel.wrGoogle_Key /
# wrGoogle_Secret, managed via the White Label admin screen). No env vars here.
# VAULT_MASTER_KEY wraps every escrowed vault key (AES-256-GCM) -- MUST be exactly 32 characters.
# This is an interim/dev-only measure; production custody belongs in a real KMS/HSM, not a .env file.
VAULT_MASTER_KEY=32_character_vault_master_key
# VAULT_CLIENT_SECRET_KEY_TOKEN signs client-app session JWTs (kept separate from SECRET_KEY_TOKEN,
# which signs staff/PassVaultpanel sessions, so the two token spaces can never be replayed against each other)
VAULT_CLIENT_SECRET_KEY_TOKEN=your_vault_client_jwt_secret_here
# VAULT_CLIENT_TOKEN_EXPIRY_TIME is the client session JWT expiration duration (e.g. 7d)
VAULT_CLIENT_TOKEN_EXPIRY_TIME=7d
# VAULT_CLIENT_APP_URL is the base URL of the client-facing app (passvault-client);
# used to build the links sent in verification and password-reset emails
VAULT_CLIENT_APP_URL=http://localhost:3001

# Google Authenticator (TOTP) 2FA -- panel (tblUsers) and vault client
# (tblClient), see sql/008_user_otp.sql / sql/vault/005_client_otp.sql and
# utilities/otpConstants.js. No new env vars: the pending-2FA challenge JWT
# reuses SECRET_KEY_TOKEN / VAULT_CLIENT_SECRET_KEY_TOKEN above, the TOTP
# secret is stored via the existing ENCRYPTION_KEY encrypt/decrypt, and a
# mail-OTP code is sent through whichever Mail Settings row sendMail()
# would already use.