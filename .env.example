# PostgreSQL database connection settings
# Sequelize connection details for the PostgreSQL database
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=example_db_password
POSTGRES_DATABASE=score_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DIALECT=postgres

# Security settings
# SALT_ROUNDS is used for bcrypt password hashing
SALT_ROUNDS=10
# SECRET_KEY_TOKEN is used to sign JWT tokens
SECRET_KEY_TOKEN=your_jwt_secret_token_here
# SECRET_HASH_KEY_TABID is used for hashing tab IDs and other data
SECRET_HASH_KEY_TABID=your_hash_secret_here
# TOKEN_EXPIRY_TIME is the JWT expiration duration (e.g. 4h, 30m, 1d)
TOKEN_EXPIRY_TIME=4h
# ENCRYPTION_KEY must be a 32-character key for AES-256 encryption
ENCRYPTION_KEY=32_character_encryption_key_here

# Application settings
# COMMANTRY_UPDATE_TIME is the look-back interval in seconds for recent commentary queries
COMMANTRY_UPDATE_TIME=3
# IMPORTMARKET_API is the remote market import endpoint (used if enabled in services)
IMPORTMARKET_API=https://api.example.com/Market/Site
# SYSTEM_PLAYER_COUNT configures the number of system players for automated services
SYSTEM_PLAYER_COUNT=2

# Error monitoring
# SENTRY_DSN is required only when ENABLE_SENTRY=TRUE
SENTRY_DSN=
# ENABLE_SENTRY is checked in app.js and should be set to TRUE to enable Sentry
ENABLE_SENTRY=FALSE

# Socket admin credentials
# Used by Socket.IO admin UI basic authentication
SOCKET_ADMIN_USERNAME=admin_user
SOCKET_ADMIN_PASSWORD=admin_password

# Background job scheduler flag
# Set to true to register cron jobs at startup
IS_CRON_ENABLE=true