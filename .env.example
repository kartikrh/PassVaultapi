PORT=5896

# PostgreSQL database connection settings
# Sequelize connection details for the PostgreSQL database
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=example_db_password
POSTGRES_DATABASE=score_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DIALECT=postgres

# Security settings
# SECRET_KEY_TOKEN, TOKEN_EXPIRY_TIME, SOCKET_ADMIN_USERNAME,
# SOCKET_ADMIN_PASSWORD, and ENCRYPTION_KEY were all moved out of .env --
# they're now tblConfigs entries (SECRETKEYTOKEN / TOKENEXPIRYTIME /
# SOCKETADMINUSERNAME / SOCKETADMINPASSWORD / APPENCRYPTIONKEY, see
# configConstants.js) so they're editable at runtime without a redeploy --
# see sql/vault/014_encryption_key_config.sql and
# sql/vault/017_staff_session_config.sql.

# Background job scheduler flag
# Set to true to register cron jobs at startup
IS_CRON_ENABLE=true

# Reverse-proxy hops in front of the API, so request.ip is the real client IP
# (activity log, rate limits, VPN check). 1 = Railway or a single nginx;
# 2 = Cloudflare -> Railway; false = API exposed directly. Also accepts
# a comma-separated list of trusted proxy IPs/CIDRs.
TRUST_PROXY=1

# App-wide per-IP request ceiling (credential endpoints have tighter limits).
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=1 minute

# Comma-separated browser origins allowed by CORS (panel + client URLs).
# Active White Label domains are always allowed. Leave empty only in local dev:
# empty = any origin is reflected (legacy behaviour).
CORS_ORIGINS=

# Vault feature settings
# Drive OAuth (utilities/googleDrive.js) reuses each White Label's own Google
# OAuth client -- same one Sign-In uses (see tblWhitelabel.wrGoogle_Key /
# wrGoogle_Secret, managed via the White Label admin screen). No env vars here.
# VAULT_MASTER_KEY, VAULT_CLIENT_SECRET_KEY_TOKEN, VAULT_CLIENT_TOKEN_EXPIRY_TIME,
# and VAULT_CLIENT_APP_URL were moved out of .env -- they're now tblConfigs
# entries (VAULTMASTERKEY / VAULTCLIENTSECRETKEYTOKEN / VAULTCLIENTTOKENEXPIRYTIME /
# VAULTCLIENTAPPURL, see configConstants.js) so they're editable at runtime
# without a redeploy -- see sql/vault/015_vault_client_config.sql.
# VAULT_MASTER_KEY is still an interim/dev-custody measure either way;
# production custody belongs in a real KMS/HSM, not tblConfigs or a .env file.

# Google Authenticator (TOTP) 2FA -- panel (tblUsers) and vault client
# (tblClient), see sql/008_user_otp.sql / sql/vault/005_client_otp.sql and
# utilities/otpConstants.js. No new env vars: the pending-2FA challenge JWT
# reuses SECRET_KEY_TOKEN / VAULT_CLIENT_SECRET_KEY_TOKEN above, the TOTP
# secret is stored via the existing ENCRYPTION_KEY encrypt/decrypt (now a
# tblConfigs entry, not an env var -- see above), and a
# mail-OTP code is sent through whichever Mail Settings row sendMail()
# would already use.