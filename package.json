{
  "name": "scoreapi",
  "version": "3.0.0",
  "description": "score-api project using the fastify framework ",
  "main": "app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "tap \"test/**/*.test.js\"",
    "start": "fastify start --options app.js",
    "info": "fastify print-routes ./routes/root.js",
    "dev": "fastify start --options -w -a 0.0.0.0 app.js",
    "dev:debug": "fastify start --options -w -d -I 9320 -a 0.0.0.0 app.js",
    "dev:local": "env-cmd -f .env.local npm run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^5.0.0",
    "@fastify/compress": "^6.4.0",
    "@fastify/cors": "^8.3.0",
    "@fastify/multipart": "^7.7.3",
    "@fastify/rate-limit": "^8.0.3",
    "@fastify/sensible": "^5.0.0",
    "@fastify/static": "^6.11.2",
    "@fastify/swagger": "^8.8.0",
    "@fastify/swagger-ui": "^1.9.3",
    "@socket.io/admin-ui": "^0.5.1",
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "countries-and-timezones": "^3.8.0",
    "country-codes-flags-phone-codes": "^1.1.1",
    "dotenv": "^16.3.1",
    "fastify": "^4.21.0",
    "fastify-cli": "^5.8.0",
    "fastify-plugin": "^4.0.0",
    "fastify-sequelize": "^1.0.4",
    "google-auth-library": "^9.13.0",
    "google-libphonenumber": "^3.2.42",
    "jsonwebtoken": "^9.0.1",
    "moment-timezone": "^0.6.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "otplib": "^12.0.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "sequelize": "^6.32.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.5",
    "ua-parser-js": "^1.0.35",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "tap": "^16.1.0"
  }
}
