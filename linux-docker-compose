services:
  # Node.js Application
  panelapi-card:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: panelapi-card
    restart: always
    ports:
      - "4002:3000"
    environment:
      - NODE_ENV=production
      - NEXT_PUBLIC_DEVICE=desktop
    networks:
      - panelapi-network

networks:
  panelapi-network:
    driver: bridge
